[configuration]

entry_symbol = "godot_radio_init"
compatibility_minimum = 4.3

[libraries]

linux.debug.x86_64 = "bin/libgodot_radio.linux.debug.x86_64.so"
linux.release.x86_64 = "bin/libgodot_radio.linux.release.x86_64.so"
windows.debug.x86_64 = "bin/libgodot_radio.windows.debug.x86_64.dll"
windows.release.x86_64 = "bin/libgodot_radio.windows.release.x86_64.dll"
android.debug.arm64 = "bin/libgodot_radio.android.debug.arm64.so"
android.release.arm64 = "bin/libgodot_radio.android.release.arm64.so"
